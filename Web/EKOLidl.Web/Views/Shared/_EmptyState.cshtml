@model EmptyState

<div class="card flex flex-col items-center gap-3 px-6 py-14 text-center">
    <span class="grid size-14 place-items-center rounded-full bg-accent-soft text-accent-strong">
        <icon name="@Model.Icon" class="size-6" />
    </span>
    <p class="font-display text-h3">@Model.Title</p>
    <p class="max-w-md text-muted">@Model.Text</p>
</div>
