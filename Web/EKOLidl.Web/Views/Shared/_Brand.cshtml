@* Project wordmark: wave mark + „Накрая стигам до морето“. Colour follows the surrounding text. *@
<a asp-controller="Home" asp-action="Index" class="group inline-flex items-center gap-3 no-underline" aria-label="Накрая стигам до морето - начало">
    <span class="grid size-10 shrink-0 place-items-center rounded-[14px] bg-linear-to-br from-tide to-lagoon text-white shadow-[0_6px_18px_-8px_rgb(14_124_134/0.8)] transition-transform duration-300 group-hover:-rotate-6">
        <icon name="waves" class="size-5" stroke="2.25" />
    </span>
    <span class="font-display text-[0.9375rem] leading-[1.1] font-semibold tracking-tight">
        Накрая стигам<br />до морето
    </span>
</a>
