@using EKOLidl.Common
@{
    string title = this.ViewData["Title"] as string;
    string pageTitle = string.IsNullOrEmpty(title) || title == GlobalConstants.SystemName
        ? $"{GlobalConstants.SystemName} · Плажове и море без пластмаса"
        : $"{title} · {GlobalConstants.SystemName}";
    string description = this.ViewData["Description"] as string
        ?? "Проект на Морски клуб „Приятели на морето“ – Варна срещу замърсяването на плажовете и морето с пластмаса. Видяхте замърсено място? Подайте сигнал.";
    string canonical = $"{this.Context.Request.Scheme}://{this.Context.Request.Host}{this.Context.Request.Path}";
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@pageTitle</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />
    <meta name="theme-color" content="#06223a" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content="@GlobalConstants.SystemName" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/onest-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geologica-cyrillic-shrp-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* Allowed by the CSP via its hash; see SecurityHeaders.JsFlagScript. *@
    <script>@Html.Raw(SecurityHeaders.JsFlagScript)</script>
    @await this.RenderSectionAsync("Head", required: false)
</head>
<body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Към съдържанието</a>

    <partial name="_Header" />

    <main id="main" class="flex-1 outline-none" tabindex="-1">
        @this.RenderBody()
    </main>

    <partial name="_Footer" />

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await this.RenderSectionAsync("Scripts", required: false)
</body>
</html>
