@using EKOLidl.Common
@{
    string title = this.ViewData["Title"] as string;
    string action = this.ViewContext.RouteData.Values["action"]?.ToString();
    bool signedIn = this.User.Identity?.IsAuthenticated == true;
    string message = this.TempData["admin-message"] as string;

    var items = new[]
    {
        (Label: "Табло", Action: "Index", Active: action == "Index"),
        (Label: "Сигнали", Action: "Signals", Active: action is "Signals" or "ModerateSignal"),
        (Label: "Събития", Action: "Events", Active: action is "Events" or "EditEvent"),
    };
}
<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@title · Администрация · @GlobalConstants.SystemName</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script>@Html.Raw(SecurityHeaders.JsFlagScript)</script>
</head>
<body class="flex min-h-dvh flex-col bg-sunken">
    <a href="#main" class="skip-link">Към съдържанието</a>

    @if (signedIn)
    {
        <header class="sticky top-0 z-40 border-b border-border bg-raised/90 backdrop-blur">
            <div class="container-page flex h-16 items-center gap-6">
                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2.5 no-underline">
                    <span class="grid size-8 place-items-center rounded-[10px] bg-linear-to-br from-tide to-lagoon text-white"><icon name="waves" class="size-4" /></span>
                    <span class="font-display text-sm font-semibold max-sm:hidden">Администрация</span>
                </a>
                <nav aria-label="Администрация" class="flex-1">
                    <ul class="flex items-center gap-1">
                        @foreach (var item in items)
                        {
                            <li>
                                <a class="rounded-full px-3 py-2 text-sm font-medium no-underline transition-colors hover:bg-accent-soft aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent-strong"
                                   asp-controller="Admin" asp-action="@item.Action" aria-current="@(item.Active ? "page" : null)">@item.Label</a>
                            </li>
                        }
                    </ul>
                </nav>
                <a class="text-sm font-medium text-muted no-underline hover:text-accent max-md:hidden" asp-controller="Home" asp-action="Index" target="_blank">
                    Към сайта <icon name="external-link" class="inline size-3.5" />
                </a>
                <form asp-controller="Admin" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-outline btn-sm">Изход</button>
                </form>
            </div>
        </header>
    }

    <main id="main" class="flex-1 outline-none" tabindex="-1">
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="container-page pt-6">
                <p class="flex items-center gap-3 rounded-xl border border-success/30 bg-success-soft p-4 font-medium text-ink" role="status">
                    <icon name="check" class="text-success" /> @message
                </p>
            </div>
        }
        @this.RenderBody()
    </main>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await this.RenderSectionAsync("Scripts", required: false)
</body>
</html>
