@* The funder's programme, shown prominently right under the home hero as a card that overlaps the hero's edge. *@
<section class="relative z-10 -mt-14 md:-mt-20" aria-labelledby="funding-title">
    <div class="container-page">
        <div class="card grid items-center gap-6 p-6 shadow-lift sm:grid-cols-[auto_1fr] sm:gap-8 sm:p-8 lg:gap-12 lg:px-12" data-reveal>
            <a class="shrink-0 justify-self-start rounded-lg bg-white p-3 ring-1 ring-abyss/10 transition-transform duration-300 hover:-translate-y-1" href="@SiteInfo.FundingProgrammeUrl" target="_blank" rel="noopener">
                <img src="/img/partners/ti-i-lidl.webp" alt="„Ти и Lidl за по-добър живот“ - инициатива на Лидл България" width="480" height="485" class="h-24 w-auto lg:h-28" decoding="async" />
            </a>
            <div>
                <h2 id="funding-title" class="eyebrow">С подкрепата на</h2>
                <p class="mt-3 max-w-3xl text-lead">
                    Проектът се осъществи благодарение на <strong class="font-semibold">„Ти и Lidl за по-добър живот“</strong> -
                    най-голямата социално отговорна инициатива на Лидл България, в партньорство с
                    Фондация „Работилница за граждански инициативи“ и Български дарителски форум.
                </p>
            </div>
        </div>
    </div>
</section>
