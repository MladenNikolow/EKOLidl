@model Gallery
@{
    int count = this.Model.Images?.Count ?? 0;
    if (count == 0)
    {
        return;
    }

    bool feature = count >= 3;

    // One or two photos fill the width; three or more get a featured first photo.
    string columns = count switch
    {
        1 => "grid-cols-1",
        2 => "grid-cols-2",
        _ => "grid-cols-2 md:grid-cols-3",
    };
}

@* Without JS every photo opens in full size; site.js turns the links into a lightbox. *@
<ul class="grid gap-3 @columns" data-gallery>
    @for (int i = 0; i < count; i++)
    {
        string alt = $"{this.Model.AltPrefix} – снимка {i + 1} от {count}";
        <li class="@(feature && i == 0 ? "col-span-2 row-span-2" : null)">
            <a class="media group block h-full overflow-hidden rounded-lg" href="@this.Model.Images[i]" data-gallery-item data-caption="@alt">
                <img src="@this.Model.Images[i]" alt="@alt" width="800" height="600" class="aspect-[4/3] h-full transition-transform duration-500 group-hover:scale-[1.04]" loading="lazy" decoding="async" />
            </a>
        </li>
    }
</ul>
