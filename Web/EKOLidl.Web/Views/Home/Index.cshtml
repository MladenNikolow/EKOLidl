@model EKOLidl.Web.ViewModels.Home.HomeViewModel

@using EKOLidl.Common
@{
    this.ViewData["Title"] = "Накрая стигам до морето";
}

<div class="row">
    <div class="col-6">
        <img class="img-responsive" src="https://ekolidlstorage.blob.core.windows.net/ekolidlblobs/front_background.jpg" alt="">
    </div>
    <div class="col-6">
        <img class="img-responsive" src="https://ekolidlstorage.blob.core.windows.net/ekolidlblobs/background.jpg" alt="">
    </div>
</div>
<div class="row">
    <div class="col sidebar-widget-area sidebar-break-md">
        <div class="widget">
            <div class="section-heading heading-dark">
                <h3 class="item-heading">СЪБИТИЯ</h3>
            </div>
            <div class="widget-latest">
                <ul class="block-list">
                    @{int i = 0;}
                    @foreach( var eventItem in Model.Events)
                    {
                        <li class="single-item">
                           <div class="item-img">
                               <a href="/Events/Details/@eventItem.Id"><img src="@eventItem.Album.Links.FirstOrDefault()" alt="Post"></a>
                               <div class="count-number">@i</div>
                           </div>
                           <div class="item-content">
                               <div class="item-ctg">Събитие</div>
                               <h4 class="item-title"><a href="/Events/Details/@eventItem.Id">@eventItem.Title</a></h4>
                           </div>
                       </li>

                       i++;
                    }
                </ul>
            </div>
        </div>
    </div>
</div>