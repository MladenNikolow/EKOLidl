@model EKOLidl.Web.ViewModels.Home.HomeViewModel

@using EKOLidl.Common
@{
    this.ViewData["Title"] = "Накрая стигам до морето";
}

<div class="continer">
    <div class="row">
        <div class="col-6">
            <img class="img-responsive" src="https://ekolidlstorage.blob.core.windows.net/ekolidlblobs/front_background.jpg" alt="">
        </div>
        <div class="col-6">
            <img class="img-responsive" src="https://ekolidlstorage.blob.core.windows.net/ekolidlblobs/background.jpg" alt="">
        </div>
    </div>
	@*Събития*@
    <div class="section-heading heading-dark" style="margin-top: 30px;">
        <h3 class="item-heading">СЪБИТИЯ</h3>
    </div>
	<div class="row">
		<div class="col-2">
		</div>
           <div id="events" class="carousel slide col-8" data-ride="carousel">
				<ol class="carousel-indicators">
					<li data-target="#events" data-slide-to="0" class="active"></li>
					<li data-target="#events" data-slide-to="1"></li>
					<li data-target="#events" data-slide-to="2"></li>
				</ol>
				<div id="events" class="carousel-inner">
					<div class="carousel-item active">
						<a href="@Url.Action("Details", "Events", new { id = Model.Events[0].Id })" class="links">
							<img class="d-block w-100" src="@Model.Events[0].Album.Links[0]"/>
						</a>
						<div class="carousel-caption d-none d-md-block">
							<h3 class="carousel-caption-title-style">@Model.Events[0].Title</h3>
							<p class="carousel-caption-text-style">@Model.Events[0].ShortDescription</p>
						</div>
					</div>
					<div class="carousel-item">
						<a href="@Url.Action("Details", "Events", new { id = Model.Events[1].Id })" class="links">
							<img class="d-block w-100" src="@Model.Events[1].Album.Links[0]"/>
						</a>
						<div class="carousel-caption d-none d-md-block carousel-caption-text-style">
							<h3 class="carousel-caption-title-style">@Model.Events[1].Title</h3>
							<p class="carousel-caption-text-style">@Model.Events[1].ShortDescription</p>
						</div>
					</div>
					<div class="carousel-item">
						<a href="@Url.Action("Details", "Events", new { id = Model.Events[2].Id })" class="links">
							<img class="d-block w-100" src="@Model.Events[2].Album.Links[0]"/>
						</a>
						<div class="carousel-caption d-none d-md-block carousel-caption-text-style">
							<h3 class="carousel-caption-title-style">@Model.Events[2].Title</h3>
							<p class="carousel-caption-text-style">@Model.Events[2].ShortDescription</p>
						</div>
					</div>
				</div>
				<a class="carousel-control-prev" href="#events" role="button" data-slide="prev">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="sr-only">Previous</span>
				</a>
				<a class="carousel-control-next" href="#events" role="button" data-slide="next">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="sr-only">Next</span>
				</a>
		</div>
		<div class="col-2">
		</div>
	</div>
	@*Сигнали*@
    <div class="section-heading heading-dark" style="margin-top: 30px;">
        <h3 class="item-heading">СИГНАЛИ</h3>
    </div>
	<div class="row">
		<div class="col-2">
		</div>
           <div id="signals" class="carousel slide col-8" data-ride="carousel">
				<ol class="carousel-indicators">
					<li data-target="#signals" data-slide-to="0" class="active"></li>
					<li data-target="#signals" data-slide-to="1"></li>
					<li data-target="#signals" data-slide-to="2"></li>
				</ol>
				<div id="events" class="carousel-inner">
					<div class="carousel-item active">
						<a href="@Url.Action("Details", "Signals", new { id = Model.Signals[0].Id })" class="links">
							<img class="d-block w-100" src="@Model.Signals[0].Album.Links[0]"/>
						</a>
						<div class="carousel-caption d-none d-md-block carousel-caption-text-style">
							<h3 class="carousel-caption-title-style">@Model.Signals[0].Title</h3>
							<p class="carousel-caption-text-style">@Model.Signals[0].Description</p>
						</div>
					</div>
					<div class="carousel-item">
						<a href="@Url.Action("Details", "Signals", new { id = Model.Signals[1].Id })" class="links">
							<img class="d-block w-100" src="@Model.Signals[1].Album.Links[0]"/>
						</a>
						<div class="carousel-caption d-none d-md-block carousel-caption-text-style">
							<h3 class="carousel-caption-title-style">@Model.Signals[1].Title</h3>
							<p class="carousel-caption-text-style">@Model.Signals[1].Description</p>
						</div>
					</div>
					<div class="carousel-item">
						<a href="@Url.Action("Details", "Signals", new { id = Model.Signals[2].Id })" class="links">
							<img class="d-block w-100" src="@Model.Signals[2].Album.Links[0]"/>
						</a>
						<div class="carousel-caption d-none d-md-block carousel-caption-text-style">
							<h3 class="carousel-caption-title-style">@Model.Signals[2].Title</h3>
							<p class="carousel-caption-text-style">@Model.Signals[2].Description</p>
						</div>
					</div>
				</div>
				<a class="carousel-control-prev" href="#signals" role="button" data-slide="prev">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="sr-only">Previous</span>
				</a>
				<a class="carousel-control-next" href="#signals" role="button" data-slide="next">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="sr-only">Next</span>
				</a>
		</div>
		<div class="col-2">
		</div>
	</div>
</div>