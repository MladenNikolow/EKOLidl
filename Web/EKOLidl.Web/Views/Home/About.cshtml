                        </div>
                        <div class="row form-group">
                            <p><i class="far fa-envelope-open"></i><b> Имейл за връзка : </b>seaclub2@gmail.com</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
