@{
    this.ViewData["Title"] = "За проекта";
}
<h1><b>@this.ViewData["Title"]</b></h1>

<section class="about-page-wrap">
    <div class="container">
        <div class="row gutters-60">
            <div class="col-lg-8">
                <div class="about-box">
                    <div class="about-figure">
                        <img src="https://www.timeoutdubai.com/cloud/timeoutdubai/2021/09/11/udHvbKwV-IMG-Dubai-UAE-1.jpg" alt="About">
                    </div>
                    <h2 class="about-title title-bar bar-center">Описание</h2>
                    <p class="item-description">
                        Описание на проекта.
                        Тук е описано повече за проекта и от кого е финансиран.
                        НАСТОЯЩИЯТ ПРОЕКТ СЕ ОСЪЩЕСТВИ БЛАГДАРЕНИЕ НА НАЙ-ГОЛЯМАТА СОЦИАЛНО ОТГОВОРНА ИНИЦИАТИВАНА ЛИДЛ БЪЛГАРИЯ 
                    <br>"ТИ И LIDL ЗА ПО-ДОБЪР ЖИВОТ", В ПАРТНЬОРСТВО С ФОНДАЦИЯ "РАБОТИЛНИЦА ЗА ГРАЖДАНСКИ ИНИЦИАТИВИ" И БЪЛГАРСКИ ДАРИТЕЛСКИ ФОРУМ
                        и куп други описания и разни...
                    </p>
                </div>
            </div>
            <div class="col-lg-4 sidebar sidebar-break-md">
                <div class="section-heading heading-dark">
                    <h2 class="item-heading">Контакти</h2>
                </div>
                <form class="about-contact-form">
                    <div class="col">
                        <div class="row form-group">
                            <p><i class="far fa-address-card"></i><b> Име : </b>Дарина Иванова</p>
                        </div>
                        <div class="row form-group">
                            <p><i class="fas fa-mobile-alt"></i><b> Телефон за връзка : </b>+359884818727</p>
                        </div>
                        <div class="row form-group">
                            <p><i class="far fa-envelope-open"></i><b> Имейл за връзка : </b>seaclub2@gmail.com</p>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
