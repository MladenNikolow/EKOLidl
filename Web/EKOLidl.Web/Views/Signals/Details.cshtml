@using EKOLidl.Data.Models.Signals
@model EKOLidl.Web.ViewModels.Signals.SignalDetailsViewModel
@{
    this.ViewData["Title"] = this.Model.Title;
    this.ViewData["Description"] = $"Сигнал за замърсяване: {this.Model.Location}. {this.Model.Description}";
    this.ViewData["HeaderOverlay"] = true;

    List<string> photos = this.Model.Album?.Links ?? new List<string>();
    List<string> resultPhotos = this.Model.Result?.Album?.Links ?? new List<string>();
    bool hasResult = this.Model.Result?.HasContent == true;
    IEnumerable<string> trash = (this.Model.TrashType ?? new List<TrashType>())
        .Select(t => t == TrashType.Other && !string.IsNullOrWhiteSpace(this.Model.OtherTrashType) ? this.Model.OtherTrashType : t.GetDescription());
    string mapUrl = "https://www.google.com/maps/search/?api=1&query=" + Uri.EscapeDataString(this.Model.Location ?? string.Empty);
}

<page-hero eyebrow="Сигнал" title="@this.Model.Title">
    <p class="mt-6 flex items-center gap-2 text-lead text-muted" data-reveal="2">
        <icon name="map-pin" class="size-5 text-coral" />
        @this.Model.Location
    </p>
    <ul class="mt-8 flex flex-wrap gap-2" data-reveal="3" aria-label="Вид отпадъци">
        @foreach (string item in trash)
        {
            <li class="chip">@item</li>
        }
        @if (hasResult)
        {
            <li class="inline-flex items-center gap-1.5 rounded-full bg-success px-3 py-1 text-sm font-semibold text-white"><icon name="check" class="size-4" /> Има резултат</li>
        }
    </ul>
</page-hero>

<div class="section pt-12 md:pt-16">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
        <article class="lg:col-span-8">
            <h2 class="sr-only">Описание</h2>
            <div class="prose-site text-lg" data-reveal>
                <partial name="_Paragraphs" model="this.Model.Description" />
            </div>

            @if (photos.Count > 0)
            {
                <section class="mt-12" aria-labelledby="photos-title">
                    <h2 id="photos-title" class="text-h3">Снимки от мястото</h2>
                    <div class="mt-6"><partial name="_Gallery" model='new Gallery(photos, this.Model.Title)' /></div>
                </section>
            }

            <section class="mt-16 rounded-xl border border-border bg-raised p-6 sm:p-10" aria-labelledby="result-title">
                <p class="eyebrow">Резултат</p>
                @if (hasResult)
                {
                    <h2 id="result-title" class="mt-3 text-h2">Какво направихме</h2>
                    @if (!string.IsNullOrWhiteSpace(this.Model.Result.Description) && this.Model.Result.Description.Trim() != EKOLidl.Data.Models.Result.NoResultsYet)
                    {
                        <div class="prose-site mt-5"><partial name="_Paragraphs" model="this.Model.Result.Description" /></div>
                    }
                    @if (resultPhotos.Count > 0)
                    {
                        <div class="mt-8"><partial name="_Gallery" model='new Gallery(resultPhotos, $"Резултат по сигнала „{this.Model.Title}“")' /></div>
                    }
                }
                else
                {
                    <h2 id="result-title" class="mt-3 text-h3">Все още няма резултат</h2>
                    <p class="mt-3 text-muted">Когато мястото бъде почистено или има развитие по сигнала, ще го покажем тук.</p>
                }
            </section>
        </article>

        <aside class="lg:col-span-4">
            <div class="card p-6 lg:sticky lg:top-28 lg:p-8">
                <h2 class="font-display text-h3">Накратко</h2>
                <dl class="mt-6 space-y-5">
                    <div>
                        <dt class="flex items-center gap-2 text-sm text-muted"><icon name="map-pin" class="size-4 text-accent" />Местоположение</dt>
                        <dd class="mt-1 pl-6 font-semibold">@this.Model.Location</dd>
                    </div>
                    <div>
                        <dt class="flex items-center gap-2 text-sm text-muted"><icon name="calendar-days" class="size-4 text-accent" />Подаден на</dt>
                        <dd class="mt-1 pl-6 font-semibold">@SiteInfo.LongDate(this.Model.CreatedOn)</dd>
                    </div>
                </dl>
                <a class="btn btn-outline mt-6 w-full" href="@mapUrl" target="_blank" rel="noopener">
                    <icon name="external-link" class="size-4" />
                    Отвори в Google Maps
                </a>
                <div class="mt-8 grid gap-3 border-t border-border pt-8">
                    <a class="btn btn-coral" asp-controller="Signals" asp-action="Create"><icon name="camera" /> Подай сигнал</a>
                    <a class="btn btn-outline" asp-controller="Signals" asp-action="Index"><icon name="arrow-left" class="size-4" /> Всички сигнали</a>
                </div>
            </div>
        </aside>
    </div>
</div>
