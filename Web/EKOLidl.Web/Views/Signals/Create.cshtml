@using EKOLidl.Data.Models.Signals
@model EKOLidl.Web.ViewModels.Signals.CreateSignalInputModel

@{
    this.ViewData["Title"] = "Добави сигнал за замърсяване";
}

<form method="post" enctype="multipart/form-data">
    <h1>@this.ViewData["Title"]</h1>
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TrashType"></label>
        <div class="container-fluid">
            @foreach (var item in Model.TrashTypeItems)
            {
                @if(item.Key == (int)TrashType.Other || item.Key == (int)TrashType.Unknown)
                {
                    continue;
                }

                <div>
                      <input type="checkbox" id="check-@item.Key" name="TrashType" value="@item.Key">
                      <label for="@item.Key">@item.Value</label>
                </div>
            }
            <div>
                  <input type="checkbox" id="check-6" name="TrashType" value="6" onclick="OtherCheckFunction()">
                  <label for="other">Други</label>
                  <input asp-for="OtherTrashType" class="form-control" id="otherTrashType" style="display:none;"/>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Images"></label>
        <input asp-for="Images" class="form-control" value="Изберете файл"/>
        <span asp-validation-for="Images" class="text-danger"></span>
    </div>

    <div class="section-heading heading-dark" style="margin-top: 30px;">
        <h3 class="item-heading">ПОДАТЕЛ</h3>
    </div>
     <div class="form-group">
        <label asp-for="ReporterNames"></label>
        <input asp-for="ReporterNames" class="form-control" />
        <span asp-validation-for="ReporterNames" class="text-danger"></span>
    </div>
     <div class="form-group">
        <label asp-for="ReporterGsm"></label>
        <input asp-for="ReporterGsm" class="form-control" />
        <span asp-validation-for="ReporterGsm" class="text-danger"></span>
    </div>
     <div class="form-group">
        <label asp-for="ReporterEmail"></label>
        <input asp-for="ReporterEmail" class="form-control" />
        <span asp-validation-for="ReporterEmail" class="text-danger"></span>
    </div>
    <input type="submit" class="btn btn-primary" />
</form>

@section Scripts {
    <script>
        function OtherCheckFunction() {
            // Get the checkbox
            var checkBox = document.getElementById("check-6");
            // Get the output text
            var text = document.getElementById("otherTrashType");

            // If the checkbox is checked, display the output text
            if (checkBox.checked == true) {
              text.style.display = 'block';
            } else {
              text.style.display = 'none';
            }
        }
    </script>
}