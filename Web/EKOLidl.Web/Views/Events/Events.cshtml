@model EKOLidl.Web.ViewModels.Events.EventsViewModel
@{
    this.ViewData["Title"] = "Събития";
    this.ViewData["Description"] = "Обучения, кампании за почистване на плажове, гмуркане и фото-лов по проекта „Накрая стигам до морето“.";
    this.ViewData["HeaderOverlay"] = true;
}

<page-hero eyebrow="Събития" title="Дейностите по проекта">
    <p class="mt-6 max-w-2xl text-lead text-muted" data-reveal="2">
        Обучения, кампании за почистване, гмуркане и фото-лов по северното черноморско крайбрежие - от Варна до Шабла.
    </p>
</page-hero>

<section class="section pt-12 md:pt-16" aria-label="Списък със събития">
    <div class="container-page">
        @if (this.Model.Events.Count == 0)
        {
            <partial name="_EmptyState" model='new EmptyState("calendar-days", "Все още няма събития", "Тук ще се появят дейностите по проекта.")' />
        }
        else
        {
            <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                @for (int i = 0; i < this.Model.Events.Count; i++)
                {
                    <li><partial name="_EventCard" model="this.Model.Events[i]" view-data='new ViewDataDictionary(this.ViewData) { ["Index"] = i % 3 }' /></li>
                }
            </ul>

            <partial name="_Pagination" model='new Pagination("Events", "Events", this.Model.Page, this.Model.PagesCount)' />
        }
    </div>
</section>
