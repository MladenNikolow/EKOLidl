@model EKOLidl.Web.ViewModels.Events.EventsViewModel

@{
    ViewData["Title"] = "Събития";
}
<h1>@ViewData["Title"]</h1>
<hr/>
<div class="row">
    @foreach (var ev in Model.Events)
    {
        <div class="card col-md-4" style="width: 18rem;">
            <img class="card-img-top" src="@ev.Album.Links[0]" alt="@ev.Title">
            <div class="card-body">
                <h5 class="card-title" style="font-weight: bold;">@ev.Title</h5>
                 <div class="row mb-4">
                    <div class="col-xl-9 col-12">
                        <ul class="entry-meta">
                            <li class="single-meta">
                                <i class="far fa-calendar-alt"></i>
                                @ev.CreatedOn.ToShortDateString()
                                <i class="far fa-solid fa-clock" style="padding-left:25px;"></i>
                                @ev.CreatedOn.ToShortTimeString()
                            </li>
                        </ul>
                    </div>
                   </div>
                <p class="card-text" style="font-weight: normal;">@ev.ShortDescription</p>
                @Html.ActionLink("Детайли", "Details", new { id=ev.Id }, new { @class = "btn btn-primary btn-sm" })
            </div>
        </div>
    }
</div>
<hr/>
<nav aria-label="...">
  <ul class="pagination justify-content-center">
    <li class="page-item @if(!@Model.HasPreviousPage) { <text>disabled</text> }">
      <a class="page-link" asp-action="Events" asp-route-page="@Model.PreviousPageNumber">Предишна</a>
    </li>
    @for(int pageNumber = Model.Page - 4; pageNumber < Model.Page; ++pageNumber)
    {
        if (pageNumber > 0)
        {
            <li class="page-item"><a class="page-link" asp-controller="Events" asp-action="Events" asp-route-page="@pageNumber">@pageNumber</a></li>
        }
    }
    <li class="page-item active" aria-current="page">
      <span class="page-link">
          @Model.Page
          <span class="sr-only">(current)</span>
      </span>
    </li>
    @for(int pageNumber = Model.Page + 1; pageNumber < Model.Page + 3; ++pageNumber)
    {
        if( pageNumber <= Model.PagesCount )
        {
            <li class="page-item"><a class="page-link" asp-controller="Events" asp-action="Events" asp-route-page="@pageNumber">@pageNumber</a></li>
        }
    }     
    <li class="page-item @if(!@Model.HasNextPage) { <text>disabled</text>}">
      <a class="page-link" asp-action="Events" asp-route-page="@Model.NextPageNumber">Следваща</a>
    </li>
  </ul>
</nav>