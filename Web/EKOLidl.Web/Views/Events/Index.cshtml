@model IEnumerable<EKOLidl.Data.Models.Event>

@{
    ViewData["Title"] = "List of Events";
}
<h1>@ViewData["Title"]</h1>

<table class="table">
  <thead>
    <tr>
      <th>
        @Html.DisplayNameFor(model => model.ShortDescription)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.LongDescription)
      </th>
      <th>
        @Html.DisplayNameFor(model => model.Result.Description)
      </th>
      <th></th>
    </tr>
  </thead>
  <tbody>
@foreach (var item in Model) {
      <tr>
        <td>
          @Html.DisplayFor(modelItem => item.ShortDescription)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.LongDescription)
        </td>
        <td>
          @Html.DisplayFor(modelItem => item.Result.Description)
        </td>
        <td>
          @Html.ActionLink("Details", "Details", new { id=item.Id }, new { @class = "btn btn-primary btn-sm" }) |
        </td>
      </tr>
}
  </tbody>
</table>