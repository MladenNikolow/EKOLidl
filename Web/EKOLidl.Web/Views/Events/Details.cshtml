@model EKOLidl.Data.Models.Event

@{
    ViewData["Title"] = "Event Details";
}
<h1>@ViewData["Title"]</h1>

<div>
  <hr />
  <dl class="row">
    <dt class = "col-sm-2">
      @Html.DisplayNameFor(model => model.ShortDescription)
    </dt>
    <dd class = "col-sm-10">
      @Html.DisplayFor(model => model.ShortDescription)
    </dd>
    <dt class = "col-sm-2">
      @Html.DisplayNameFor(model => model.LongDescription)
    </dt>
    <dd class = "col-sm-10">
      @Html.DisplayFor(model => model.LongDescription)
    </dd>
    <dt class = "col-sm-2">
      @Html.DisplayNameFor(model => model.Result.Description)
    </dt>
    <dd class = "col-sm-10">
          @Html.DisplayFor(model => model.Result.Description)
    </dd>
  </dl>
</div>