@model EKOLidl.Web.ViewModels.Events.EventDetailsViewModel
@{
    this.ViewData["Title"] = this.Model.Title;
    this.ViewData["Description"] = this.Model.ShortDescription;
    this.ViewData["HeaderOverlay"] = true;

    List<string> photos = this.Model.Album?.Links ?? new List<string>();
    List<string> resultPhotos = this.Model.Result?.Album?.Links ?? new List<string>();
    bool hasResult = this.Model.Result?.HasContent == true;
}

<page-hero eyebrow="Събитие" title="@this.Model.Title">
    @if (!string.IsNullOrWhiteSpace(this.Model.ShortDescription))
    {
        <p class="mt-6 max-w-2xl text-lead text-muted" data-reveal="2">@this.Model.ShortDescription</p>
    }
    <ul class="mt-8 flex flex-wrap gap-2" data-reveal="3" aria-label="Кога">
        <li class="chip"><icon name="calendar-days" class="size-4" /> @SiteInfo.LongDate(this.Model.EventDate)</li>
        <li class="chip"><icon name="clock" class="size-4" /> @SiteInfo.Time(this.Model.EventDate)</li>
        @if (this.Model.Duration > 0)
        {
            <li class="chip"><icon name="hourglass" class="size-4" /> @SiteInfo.Hours(this.Model.Duration)</li>
        }
    </ul>
</page-hero>

<div class="section pt-12 md:pt-16">
    <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
        <article class="lg:col-span-8">
            @if (photos.Count > 0)
            {
                <figure class="media overflow-hidden rounded-xl shadow-soft" data-reveal>
                    <img src="@photos[0]" alt="@this.Model.Title" width="1200" height="800" class="aspect-[3/2]" fetchpriority="high" decoding="async" />
                </figure>
            }

            <div class="prose-site mt-10 text-lg" data-reveal>
                <partial name="_Paragraphs" model="this.Model.LongDescription" />
            </div>

            @if (photos.Count > 1)
            {
                <section class="mt-16" aria-labelledby="photos-title">
                    <h2 id="photos-title" class="text-h2">Снимки</h2>
                    <div class="mt-6"><partial name="_Gallery" model='new Gallery(photos, this.Model.Title)' /></div>
                </section>
            }

            @if (hasResult)
            {
                <section class="mt-16 rounded-xl border border-border bg-raised p-6 sm:p-10" aria-labelledby="result-title">
                    <p class="eyebrow">Резултати</p>
                    <h2 id="result-title" class="mt-3 text-h2">Какво постигнахме</h2>
                    @if (!string.IsNullOrWhiteSpace(this.Model.Result.Description) && this.Model.Result.Description.Trim() != EKOLidl.Data.Models.Result.NoResultsYet)
                    {
                        <div class="prose-site mt-5"><partial name="_Paragraphs" model="this.Model.Result.Description" /></div>
                    }
                    @if (resultPhotos.Count > 0)
                    {
                        <div class="mt-8"><partial name="_Gallery" model='new Gallery(resultPhotos, $"Резултати от „{this.Model.Title}“")' /></div>
                    }
                </section>
            }
        </article>

        <aside class="lg:col-span-4">
            <div class="card p-6 lg:sticky lg:top-28 lg:p-8">
                <h2 class="font-display text-h3">Накратко</h2>
                @{
                    var facts = new List<(string Icon, string Label, string Value)>
                    {
                        ("calendar-days", "Дата", SiteInfo.LongDate(this.Model.EventDate)),
                        ("clock", "Начало", SiteInfo.Time(this.Model.EventDate)),
                    };
                    if (this.Model.Duration > 0)
                    {
                        facts.Add(("hourglass", "Продължителност", SiteInfo.Hours(this.Model.Duration)));
                    }
                }
                <dl class="mt-6 space-y-5">
                    @foreach (var fact in facts)
                    {
                        <div>
                            <dt class="flex items-center gap-2 text-sm text-muted"><icon name="@fact.Icon" class="size-4 text-accent" />@fact.Label</dt>
                            <dd class="mt-1 pl-6 font-semibold">@fact.Value</dd>
                        </div>
                    }
                </dl>
                <div class="mt-8 grid gap-3 border-t border-border pt-8">
                    <a class="btn btn-coral" asp-controller="Signals" asp-action="Create"><icon name="camera" /> Подай сигнал</a>
                    <a class="btn btn-outline" asp-controller="Events" asp-action="Events"><icon name="arrow-left" class="size-4" /> Всички събития</a>
                </div>
            </div>
        </aside>
    </div>
</div>
